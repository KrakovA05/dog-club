# ──────────────────────────────────────────────────────────────────────────
# Self-hosted Supabase для Лапа Клуб — пример переменных окружения.
# Скопируйте в selfhost/.env и заполните. НЕ коммитьте .env в git.
#
# Сгенерировать секреты:
#   JWT_SECRET          : openssl rand -hex 32         (>= 32 символов)
#   POSTGRES_PASSWORD   : openssl rand -hex 24
#   ANON_KEY / SERVICE_ROLE_KEY:
#     JWT, подписанные JWT_SECRET (HS256), с полями role=anon / role=service_role.
#     Удобнее всего сгенерировать на https://supabase.com/docs/guides/self-hosting/docker
#     (раздел "Generate API keys") или скриптом scripts/migration/gen-keys.md.
# ──────────────────────────────────────────────────────────────────────────

############
# Секреты
############
POSTGRES_PASSWORD=PLACEHOLDER_change_me
JWT_SECRET=PLACEHOLDER_at_least_32_chars_long_secret
ANON_KEY=PLACEHOLDER_jwt_anon
SERVICE_ROLE_KEY=PLACEHOLDER_jwt_service_role

# Доступ в Studio (через Kong basic-auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=PLACEHOLDER_change_me

############
# База данных
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Внешний порт БД на хосте (для pg_dump/restore с вашей машины). Закройте фаерволом.
POSTGRES_PORT_EXTERNAL=5432

############
# Внешние URL
############
# Адрес, по которому приложение и браузер обращаются к Supabase (Kong gateway).
# В проде — ваш домен с TLS, напр. https://db.lapaclub.ru
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# Адрес фронтенда (для ссылок в письмах GoTrue и CORS). Прод: https://lapaclub.ru
SITE_URL=http://localhost:3000
# Доп. разрешённые redirect-адреса (через запятую). Прод: https://lapaclub.ru
ADDITIONAL_REDIRECT_URLS=

# Порт Kong на хосте
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Auth (GoTrue)
############
# Авто-подтверждение email включено — SMTP НЕ настраиваем (по требованию проекта).
# Пользователь подтверждается сразу при регистрации, письмо не отправляется.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMS_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
# Срок жизни access-токена (сек). Совпадает с config.toml (jwt_expiry).
GOTRUE_JWT_EXPIRY=3600
# Минимальная длина пароля (ст. 19 152-ФЗ — меры защиты). Существующие более
# короткие пароли продолжают работать: проверка только при регистрации/смене.
GOTRUE_PASSWORD_MIN_LENGTH=8

############
# Realtime (приложение не использует, но сервис в стеке)
############
# openssl rand -hex 16  → ровно 32 hex-символа (16 байт)
REALTIME_DB_ENC_KEY=PLACEHOLDER_32_hex_chars________
# openssl rand -base64 48
REALTIME_SECRET_KEY_BASE=PLACEHOLDER_base64_secret

############
# Studio / организация
############
STUDIO_DEFAULT_ORGANIZATION=Лапа Клуб
STUDIO_DEFAULT_PROJECT=lapaclub
